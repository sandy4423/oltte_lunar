# ============================================
# 올때만두 주문 시스템 환경변수
# .env.local에 복사하여 실제 값을 입력하세요.
# ============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Toss Payments V1
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxx
TOSS_SECRET_KEY=test_sk_xxxxxxxx

# Solapi (SMS)
SOLAPI_API_KEY=your-solapi-api-key
SOLAPI_API_SECRET=your-solapi-api-secret
SOLAPI_SENDER_NUMBER=0328325012

# Slack (관리자 알림)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# 사이트 URL (선택 - 기본값: https://www.olttefood.com)
NEXT_PUBLIC_SITE_URL=https://www.olttefood.com

# Vercel Cron Secret (선택 - 자동취소 cron job 인증)
CRON_SECRET=your-cron-secret

# 관리자 인증
# 공유 비밀번호 환경변수는 더 이상 사용하지 않는다.
# 관리자 API는 staff_accounts 테이블의 활성 계정 비밀번호로 인증한다.
# (src/lib/adminAuth.server.ts 참고)
